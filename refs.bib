% References for the essay, in BibTeX format.
%
% Cite a source in essay.md as [@key], where "key" is the part after the first
% comma below. Typst then formats the in-text citation and the reference list
% in APA style automatically. Do not write the reference list by hand.
%
% Example entry (replace with real sources):
%
% @article{smith2020,
%   author  = {Smith, John},
%   title   = {The title of the article},
%   journal = {Journal of Something},
%   year    = {2020},
%   volume  = {12},
%   number  = {3},
%   pages   = {45--67},
% }

@article{miyatsu2018,
  author  = {Miyatsu, Toshiya and Nguyen, Khuyen and McDaniel, Mark A.},
  title   = {Five Popular Study Strategies: Their Pitfalls and Optimal Implementations},
  journal = {Perspectives on Psychological Science},
  year    = {2018},
  volume  = {13},
  number  = {3},
  pages   = {390--407},
  doi     = {10.1177/1745691617710510},
}

